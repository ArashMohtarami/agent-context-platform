# Copy this file to .env and provide unique, non-empty values, or run
# ./scripts/generate-dev-secrets.sh to create an ignored local configuration.
APP_ENV=development
APP_NAME=Agent Context Platform
LOG_LEVEL=INFO
# Opt-in maintenance foundation. Adoption seals domain traffic until Phase 2.
V6_TENANT_FOUNDATION=false
# Scoped runtime after explicit adoption and isolation preparation.
V6_TENANT_ISOLATION=false
# Phase 3: requires activated Phase 2 isolation, HTTPS and explicit private mounts.
V6_LOCAL_IDENTITY=false
V6_SSO=false
# Requires verified Phase 4 and reviewed policy cutover; never enables a dashboard.
V6_MANAGEMENT_POLICY=false
V6_HUMAN_MANAGEMENT=false
V6_MANAGED_AGENTS=false
# Serve the built same-origin console only after the earlier V6 cutover gates.
V6_CONSOLE_ENABLED=false
V6_OIDC_REGISTRATIONS_FILE=
V6_BROWSER_ORIGIN=
V6_MFA_KEYRING_FILE=
V6_MAIL_SINK_DIRECTORY=
# Optional separately mounted installation-operator metrics credential.
OPERATOR_METRICS_TOKEN_FILE=
API_PORT=8000

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=
MONGODB_REPLICA_SET=rs0
MONGODB_APP_NAME=agent-context-platform
MONGODB_ROOT_USERNAME=
MONGODB_APP_USERNAME=
MONGOT_SYNC_USERNAME=
MONGOT_LOG_LEVEL=INFO

# Authentication. Keys are issued with `contextctl keys create` and stored as a
# hash, so there is nothing here to set: a key is minted once and shown once.
# Tenant domain startup refuses false. Each admitted key belongs to one org;
# a header or query parameter cannot establish organization authority.
API_AUTH_ENABLED=true
# Records who was allowed or refused what. Never the content of an answer.
AUDIT_LOG_ENABLED=true
# Refused before the body is read. Comfortably above the largest context item
# the model accepts, which is 200 000 characters.
API_MAX_REQUEST_BYTES=1048576
# Remote MCP transport. Public `/mcp` must terminate TLS before it reaches the
# API. HTTP is accepted only from a direct loopback peer in development; this
# setting must be false when APP_ENV=production.
MCP_REMOTE_ALLOW_LOOPBACK_HTTP=true
MCP_REMOTE_MAX_SESSIONS=100
# Enable forwarded TLS/client data only for named, trusted reverse-proxy IP
# ranges. Never use `*`; leave both disabled for direct local development.
API_PROXY_HEADERS=false
API_FORWARDED_ALLOW_IPS=

# Bound database operations, including server selection when MongoDB is
# unreachable. Tune the timeout for your workload and check startup migrations
# and index creation when changing it.
MONGODB_TIMEOUT_MS=15000
MONGODB_MAX_POOL_SIZE=50
# Requests in flight at once, past which the server answers 503 rather than
# accepting work it cannot finish, and how long a shutdown waits for what is
# already running.
API_MAX_CONCURRENT_REQUESTS=50
API_SHUTDOWN_TIMEOUT_SECONDS=20
API_KEEP_ALIVE_SECONDS=5
# The whole of a readiness check. Kept under the container health check's own
# timeout, so a readiness answer never arrives after the thing asking for it
# has given up.
API_READINESS_TIMEOUT_SECONDS=3

# Container resource ceilings, applied by Compose. Leave room for idle
# processes, index growth, ingestion and query concurrency. Measure your own
# deployment before tuning these limits.
MONGOT_MEM_LIMIT=2g
MONGODB_MEM_LIMIT=2g
API_MEM_LIMIT=2g
MCP_MEM_LIMIT=512m

# Observability. Logs are structured JSON on stdout and always on; this governs
# the metrics only. /metrics renders in-process counters and latency summaries
# in the Prometheus text format, to a caller holding `system:read` — nothing is
# pushed anywhere and no collector is required. Off removes the endpoint
# entirely rather than serving an empty one.
METRICS_ENABLED=true

# Backups. MongoDB is the only primary state: search indexes are rebuilt from
# it, and the vectors live inside the documents so they come along. The
# directory is created 0700 and each file 0600 — one archive is every document
# the deployment holds. Do not put it anywhere the platform serves.
# The container writes as uid 999, so create the host directory for it:
#   mkdir -p backups && sudo chown 999:999 backups && chmod 700 backups
BACKUP_HOST_DIRECTORY=./backups
BACKUP_DIRECTORY=/backups
# Kept: the newest backup of each of the last N days, ISO weeks, and months.
# Tiers overlap rather than add up, so this is at most 14 files. All three zero
# is refused at startup.
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_RETAIN_MONTHLY=3
BACKUP_TIMEOUT_SECONDS=3600

SKILLS_DIRECTORY=skills
SKILL_MAX_FILE_BYTES=1000000
SKILL_CHUNK_MIN_TOKENS=500
SKILL_CHUNK_TARGET_TOKENS=650
SKILL_CHUNK_MAX_TOKENS=800
SKILL_CHUNK_OVERLAP_TOKENS=75

# Local embedding model. Vectors from different models must never be mixed, so
# changing EMBEDDING_MODEL requires re-embedding and a matching dimension.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# auto, cpu, cuda, or mps. auto falls back to cpu when no accelerator exists.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_BATCH_TEXTS=256
EMBEDDING_MAX_TEXT_CHARACTERS=20000
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
# Set to false for air-gapped hosts once the model files are on the volume.
EMBEDDING_ALLOW_DOWNLOADS=true

# Vector search. The index dimensions always come from the loaded model, so
# there is no dimension setting here to drift out of step with it.
VECTOR_SEARCH_CANDIDATE_MULTIPLIER=10
VECTOR_SEARCH_MAX_CANDIDATES=1000

# Hybrid ranking. The weights express relative influence and are normalized
# before use, so they need not sum to one. These are starting values for
# retrieval evaluation, not measured optima.
RETRIEVAL_WEIGHT_VECTOR=0.45
RETRIEVAL_WEIGHT_LEXICAL=0.25
RETRIEVAL_WEIGHT_IMPORTANCE=0.15
RETRIEVAL_WEIGHT_RECENCY=0.10
RETRIEVAL_WEIGHT_SOURCE_PRIORITY=0.05
# Content loses half its recency score every this many days.
RETRIEVAL_RECENCY_HALF_LIFE_DAYS=90
# Share of the shorter result that must also appear in a better-ranked one
# before it is treated as a duplicate.
RETRIEVAL_DUPLICATE_OVERLAP=0.85
# Context tokens returned per query, and the ceiling a request may ask for.
RETRIEVAL_TOKEN_BUDGET=4000
RETRIEVAL_MAX_TOKEN_BUDGET=16000
# Research packets use an independent larger default but the same bounded maximum.
RESEARCH_RETRIEVAL_TOKEN_BUDGET=8000
RESEARCH_RETRIEVAL_MAX_TOKEN_BUDGET=16000
# V3 untrusted research-acquisition limits. Source bytes are capped at 700000
# in the provider before parsing; these bound persistent source records, active
# parser/embedding work, and chunks generated by one immutable snapshot.
RESEARCH_MAX_SOURCES_PER_PROJECT=500
RESEARCH_MAX_INGESTION_CONCURRENCY=2
RESEARCH_MAX_CHUNKS_PER_INGESTION=500
# Every search is reported to the structured log without its query text.
# Enabling this also stores one retrieval_logs record per search, query
# included, which is a retention decision rather than a default.
RETRIEVAL_LOG_ENABLED=false

# MCP server. It speaks its protocol over stdin and stdout, so it binds no
# port; it reaches the platform through the Context API and holds no database
# credentials of its own.
MCP_API_BASE_URL=http://127.0.0.1:8000
MCP_SERVER_NAME=agent-context-platform
# The API-client ceiling. Tool-class deadlines below enforce the normal fast
# and standard budgets, while this allows a declared long-running V3 job path
# to return its persisted job result without an unbounded request.
MCP_REQUEST_TIMEOUT_SECONDS=120
# Per-client, process-local MCP gateway protection for one self-hosted
# instance. These are intentionally not Redis-backed; a future shared backend
# implements the same client-limit interface if deployment topology changes.
MCP_REQUESTS_PER_MINUTE=120
MCP_CONCURRENT_CALLS=8
MCP_WRITES_PER_MINUTE=30
MCP_RESEARCH_INGESTIONS_PER_HOUR=10
MCP_LONG_RUNNING_JOBS_PER_CLIENT=2
MCP_FAST_TIMEOUT_SECONDS=10
MCP_STANDARD_TIMEOUT_SECONDS=30
MCP_LONG_RUNNING_TIMEOUT_SECONDS=120
MCP_IDEMPOTENCY_RETENTION_SECONDS=86400
# Comma-separated. Leaving these empty grants every scope, project, and profile,
# which is the local case: a stdio server is reachable only by the process that
# spawned it. Narrow them to hand one agent limited V1/V2 access.
MCP_SCOPES=
MCP_PROJECT_IDS=
MCP_PROFILE_IDS=
# Sent to the Context API as a bearer token when a deployment issues one.
# Point MCP_API_TOKEN_FILE at a mounted secret rather than setting it inline.
MCP_API_TOKEN_FILE=

# contextctl. Separate from the MCP settings on purpose: an operator's
# terminal and an agent's tool server are different callers.
CONTEXTCTL_API_BASE_URL=http://127.0.0.1:8000
CONTEXTCTL_REQUEST_TIMEOUT_SECONDS=30
# Prefer the file: a token in an environment variable is readable through
# /proc and ends up in shell history.
CONTEXTCTL_API_TOKEN_FILE=

# These files must exist and must not be committed.
MONGODB_ROOT_PASSWORD_SECRET=./secrets/mongodb-root-password
MONGODB_APP_PASSWORD_SECRET=./secrets/mongodb-app-password
MONGODB_KEYFILE_SECRET=./secrets/mongodb-keyfile
MONGOT_SYNC_PASSWORD_SECRET=./secrets/mongot-sync-password
