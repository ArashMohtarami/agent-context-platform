syncSource:
  replicaSet:
    hostAndPort: "mongodb:27017"
    scramAuth:
      username: "__MONGOT_SYNC_USERNAME__"
      passwordFile: "/tmp/mongot-sync-password"
      authSource: "admin"
      tls:
        enabled: false
  replicationReader:
    readPreference: primaryPreferred

storage:
  dataPath: "/data/mongot"

server:
  grpc:
    address: "0.0.0.0:27028"
    tls:
      mode: disabled

metrics:
  enabled: true
  address: "0.0.0.0:9946"

healthCheck:
  address: "0.0.0.0:8080"

logging:
  verbosity: __MONGOT_LOG_LEVEL__
