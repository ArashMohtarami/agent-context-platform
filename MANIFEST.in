include LICENSE README.md
exclude agent-context-platform-*.md my-doc.md
exclude docs/mvp-user-guide.md docs/open-source-release.md docs/repository-content-launch.md
prune .private
prune .codex
prune secrets
prune backups
prune dist
prune build
global-exclude .env .env.local .env.production *.py[cod]

# The public source distribution includes the independently built browser client.
graft dashboard
prune dashboard/node_modules
prune dashboard/dist
prune dashboard/test-results
prune dashboard/playwright-report
prune dashboard/coverage
prune dashboard/.vite
prune dashboard/.private

# Reproducible same-origin deployment and operator runbooks.
include Dockerfile docker-compose.yml .dockerignore .gitignore .env.example
recursive-include deploy *.yml *.conf *.template *.sh *.md *.txt *LICENSE* THIRD-PARTY-NOTICES
recursive-include scripts *.py *.sh *.js
prune dashboard/blob-report
prune dashboard/.npm
global-exclude *.tsbuildinfo *.key *.pem
include requirements.lock requirements-dev.lock
recursive-include docker *.py *.template
include docs/backup.md docs/deployment.md docs/dashboard-*.md docs/guide/public-sources.json
