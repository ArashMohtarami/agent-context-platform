worker_processes auto;
pid /tmp/nginx.pid;
# nginx request-error diagnostics may include an OIDC callback query string.
# Content-free API diagnostics and healthchecks are the operational signals.
error_log /dev/null;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Query strings can contain OIDC codes; neither access nor request-body logs.
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    resolver 127.0.0.11 valid=10s ipv6=off;
    map $status $asset_cache {
        200 "public, max-age=31536000, immutable";
        304 "public, max-age=31536000, immutable";
        default "no-store";
    }
    server {
        listen 8443 ssl;
        server_name ${CONSOLE_SERVER_NAME};
        if ($host != "${CONSOLE_SERVER_NAME}") { return 421; }
        ssl_certificate /run/secrets/console-cert;
        ssl_certificate_key /run/secrets/console-key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        root /usr/share/nginx/html;
        autoindex off;
        absolute_redirect off;
        client_max_body_size 1m;
        include /etc/acp-console/headers.conf;
        add_header Cache-Control no-store always;
        proxy_hide_header Cache-Control;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite attacker-supplied forwarding headers. This is the only edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_buffering off;
        proxy_read_timeout 130s;
        set $api_upstream ${CONSOLE_UPSTREAM};
        location = /console { return 308 /console/; }
        location ^~ /console/assets/ {
            include /etc/acp-console/headers.conf;
            add_header Cache-Control $asset_cache always;
            try_files $uri =404;
        }
        location ^~ /console/licenses/ { try_files $uri =404; }
        location = /console/LICENSE { try_files $uri =404; }
        # Missing files (including chunk/map/font/logo requests) are real 404s.
        location ~ ^/console/.*\.[^/]+$ { try_files $uri =404; }
        location /console/ {
            limit_except GET HEAD { deny all; }
            try_files $uri /console/index.html;
        }
        location = /api { proxy_pass http://$api_upstream; }
        location /api/ { proxy_pass http://$api_upstream; }
        location = /mcp { proxy_pass http://$api_upstream; }
        location /mcp/ { proxy_pass http://$api_upstream; }
        location = /health/live { proxy_pass http://$api_upstream; }
        location = /health/ready { proxy_pass http://$api_upstream; }
        # Raw metrics, archives, API docs and the public marketing site are not exposed.
        location / { return 404; }
    }
}
